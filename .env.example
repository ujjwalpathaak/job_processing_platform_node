PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/job_platform
NODE_ENV=development

AMQP_URL=amqp://localhost
AMQP_PUBLISH_DRAIN_TIMEOUT_MS=2000
AMQP_PREFETCH_STANDARD=32
AMQP_PREFETCH_CRITICAL=32
AMQP_PREFETCH_EXTERNAL=24
AMQP_PREFETCH_RETRY=64
AMQP_PREFETCH_LOG_RAG=8

DB_POOL_MAX=50
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

RAG_INGESTION_ENABLED=true

HANDLER_FAILURE_RATE_EMAIL=0.05
HANDLER_FAILURE_RATE_REFUND=0.05
HANDLER_FAILURE_RATE_WEBHOOK=0.08
HANDLER_FAILURE_RATE_CRM_SYNC=0.10

HANDLER_DELAY_EMAIL_MIN_MS=30
HANDLER_DELAY_EMAIL_MAX_MS=120
HANDLER_DELAY_REFUND_MIN_MS=100
HANDLER_DELAY_REFUND_MAX_MS=400
HANDLER_DELAY_WEBHOOK_MIN_MS=400
HANDLER_DELAY_WEBHOOK_MAX_MS=1800
HANDLER_DELAY_CRM_SYNC_MIN_MS=300
HANDLER_DELAY_CRM_SYNC_MAX_MS=1200
HANDLER_DELAY_REPORT_MIN_MS=2500
HANDLER_DELAY_REPORT_MAX_MS=4000
